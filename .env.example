# Netlify Functions only. Never place secret values in frontend files.
FLW_PUBLIC_KEY=FLWPUBK_TEST-...
FLW_SECRET_KEY=FLWSECK_TEST-...
FLW_WEBHOOK_HASH=replace-with-a-random-webhook-secret
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: configure to send paid event tickets by email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Goal Diggers <tickets@your-verified-domain.rw>